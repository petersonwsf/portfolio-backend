# --- MongoDB (docker-compose) ---
MONGO_USUARIO=
MONGO_SENHA=
MONGO_BANCO=portfolio

# --- Armazenamento de imagens: RustFS (S3 compatível, docker-compose) ---
# Credenciais usadas pelo container e pelo backend
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=portfolio
S3_REGIAO=us-east-1
# Endpoint da API S3 (acessado pelo backend)
S3_ENDPOINT=http://localhost:9000
# URL pública base usada nas imagens salvas (endpoint + bucket)
S3_URL_PUBLICA=http://localhost:9000/portfolio

# --- Backend ---
PORTA=3333
MONGODB_URI=
# Origens permitidas pelo CORS, separadas por vírgula (frontend e admin)
ORIGENS_PERMITIDAS=http://localhost:5173,http://localhost:5174

# --- Autenticação do admin ---
ADMIN_USUARIO=
# Gere com: npm run gerar-hash -- "sua-senha" (dentro de backend/)
ADMIN_SENHA_HASH=
JWT_SEGREDO=
JWT_EXPIRA_EM=2h

# --- E-mail do formulario de contato ---
# Provedor: resend (padrao) ou smtp
EMAIL_PROVEDOR=resend
# Para onde chegam as mensagens do formulario
EMAIL_DESTINO=
# Remetente de um dominio verificado no Resend, ex.: Portfolio <contato@seudominio.com>
EMAIL_REMETENTE=
# Resend: chave de API (resend.com/api-keys)
RESEND_API_KEY=
# SMTP (so se EMAIL_PROVEDOR=smtp)
SMTP_HOST=
SMTP_PORTA=587
# true = TLS direto (porta 465); false = STARTTLS (porta 587)
SMTP_SEGURO=false
SMTP_USUARIO=
SMTP_SENHA=
